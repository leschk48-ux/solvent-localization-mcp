# When PAYMENTS_ENABLED=1, paid tools charge USDC on Solana mainnet via x402,
# settled by the PayAI facilitator to this address (SOLVENT agent wallet):
PAY_TO_ADDRESS=ApC24q9FAsRV1ByKccGjySzchzXPwFx6AZL4Tir7NPbV
PRICE_LOCALIZE_USDC=0.10
PRICE_REVIEW_USDC=0.10

# Facilitator (no account/API key needed for the standard exact-scheme lane):
FACILITATOR_URL=https://facilitator.payai.network
